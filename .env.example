# These are NOT read from a file on Netlify. Add them in:
# Netlify dashboard -> Project configuration -> Environment variables.
# This file only documents the names. Never commit real values.

# --- Required for email notifications ---
GMAIL_USER=your.address@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop      # 16-character Google App Password (not your normal password)

# --- Recommended ---
NOTIFY_EMAIL=your.address@gmail.com      # where notifications go (defaults to GMAIL_USER)
ADMIN_TOKEN=                              # 24+ random characters; unlocks /admin.html
NOTIFY_TIMEZONE=Asia/Kolkata              # shows the submit time in your timezone as well as UTC

# --- Optional spam protection (Cloudflare Turnstile, free) ---
TURNSTILE_SECRET_KEY=                     # also set TURNSTILE_SITE_KEY in public/js/config.js
